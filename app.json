{
  "expo": {
    "name": "YPA Sasula",
    "slug": "ypa-sasula",
    "scheme": "ypasasula",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "site.bwongo.ypasasula" },
